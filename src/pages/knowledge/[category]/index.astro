---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { CATEGORIES, getCategory } from '../../../lib/knowledge';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.key } }));
}

const { category } = Astro.props;
const info = getCategory(category);

const posts = (await getCollection('knowledge'))
  .filter((p) => p.slug.split('/')[0] === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Base title={`${info?.name ?? category} · meark-wiki`} activeCategory={category}>
  <section class="page-head">
    <p class="crumb"><a href="/knowledge/">全部知识</a></p>
    <h1>{info?.name ?? category}</h1>
    {info && <p class="desc">{info.description}</p>}
  </section>

  <div class="paper">
    <p class="count">{posts.length} 篇</p>
    <ul class="post-list">
      {posts.map((p) => (
        <li>
          <a class="post-item" href={`/knowledge/${category}/${p.slug.split('/').slice(1).join('/')}/`}>
            <span class="post-date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
            <span class="post-title">{p.data.title}</span>
            {p.data.tags.length > 0 && <span class="post-tags">{p.data.tags.join(' · ')}</span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>

<style>
  .page-head { margin-bottom: 2rem; }
  .crumb { color: var(--muted); font-size: 0.92rem; margin: 0 0 0.75rem; }
  .crumb a { color: var(--muted); text-decoration: none; }
  .crumb a:hover { color: var(--ink); text-decoration: underline; }
  .page-head h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .page-head .desc { color: var(--muted); margin: 0; }

  /* 一张纸 */
  .paper {
    background: var(--field);
    color: var(--field-ink);
    padding: 2rem 2.25rem 1.6rem;
    max-width: 860px;
  }
  .count {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--field-muted);
    margin: 0 0 0.5rem;
  }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.95rem 0.75rem;
    text-decoration: none;
    color: var(--field-ink);
  }
  .post-item:hover { background: rgba(28, 21, 13, 0.06); }
  .post-item:last-child { padding-bottom: 0.3rem; }
  .post-item:hover .post-title { text-decoration: underline; text-underline-offset: 4px; }
  .post-date { font-family: var(--font-display); font-weight: 500; font-size: 0.88rem; color: var(--field-muted); }
  .post-title { font-weight: 600; font-size: 1.05rem; }
  .post-tags { font-family: var(--font-display); font-weight: 500; font-size: 0.82rem; color: var(--field-muted); }

  @media (max-width: 640px) {
    .paper { padding: 1.4rem 1.25rem 1.2rem; }
    .post-item { grid-template-columns: 1fr auto; }
    .post-date { font-size: 0.82rem; }
  }
</style>
