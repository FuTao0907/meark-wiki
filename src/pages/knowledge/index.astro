---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORIES } from '../../lib/knowledge';

const posts = await getCollection('knowledge');
const sorted = [...posts].sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const grouped = CATEGORIES.map((c) => ({
  category: c,
  items: sorted.filter((p) => p.slug.split('/')[0] === c.key),
})).filter((g) => g.items.length > 0);
---

<Base title="全部知识 · meark-wiki" activeCategory="">
  <section class="page-head">
    <h1>全部知识</h1>
    <p>共 {sorted.length} 篇，按分类归档。</p>
  </section>

  <div class="banner" aria-hidden="true"></div>

  {grouped.map((g) => (
    <section class="cat-block">
      <div class="cat-head">
        <h2>{g.category.name}</h2>
        <a href={`/knowledge/${g.category.key}/`}>分类页 →</a>
      </div>
      <ul class="post-list">
        {g.items.map((p) => (
          <li>
            <a class="post-item" href={`/knowledge/${p.slug}/`}>
              <span class="post-date">{p.data.pubDate.toISOString().slice(0, 10)}</span>
              <span class="post-title">{p.data.title}</span>
              {p.data.tags.length > 0 && (
                <span class="post-tags">{p.data.tags.join(' · ')}</span>
              )}
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>

<style>
  .page-head { margin-bottom: 2rem; }
  .page-head h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 0.5rem;
  }
  .page-head p { color: var(--muted); margin: 0; }

  /* 图书馆纵深横幅 */
  .banner {
    height: clamp(160px, 30vw, 260px);
    margin: 2rem 0 3.5rem;
    background: url('/images/library-aisle.jpg') center/cover no-repeat;
    filter: brightness(0.8);
  }

  .cat-block { margin-bottom: 3rem; }
  .cat-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .cat-head h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.35rem;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .cat-head a { color: var(--accent); text-decoration: none; font-size: 0.92rem; }
  .cat-head a:hover { text-decoration: underline; }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0.5rem 1.75rem;
    background: var(--field);
    color: var(--field-ink);
  }
  .post-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 0.95rem 0.75rem;
    text-decoration: none;
    color: var(--field-ink);
  }
  .post-item:hover { background: rgba(28, 21, 13, 0.06); }
  .post-item:last-child { padding-bottom: 0.3rem; }
  .post-item:hover .post-title { text-decoration: underline; text-underline-offset: 4px; }
  .post-date { font-family: var(--font-display); font-weight: 500; font-size: 0.88rem; color: var(--field-muted); }
  .post-title { font-weight: 600; font-size: 1.02rem; }
  .post-tags { font-family: var(--font-display); font-weight: 500; font-size: 0.82rem; color: var(--field-muted); }

  @media (max-width: 640px) {
    .post-item { grid-template-columns: 1fr auto; }
    .post-date { font-size: 0.82rem; }
    .post-list { padding: 0.4rem 1.25rem; }
  }
</style>
